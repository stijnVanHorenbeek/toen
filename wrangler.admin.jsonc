{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "toen-admin",
	"main": ".generated/workers/admin-api.js",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.1
		}
	},
	"secrets_store_secrets": [
		{
			"binding": "ACCESS_TEAM_DOMAIN_STORE",
			"store_id": "544f744dc2994b1b8eeab53d76689f8a",
			"secret_name": "toen-access-team-domain"
		},
		{
			"binding": "ACCESS_POLICY_AUD_STORE",
			"store_id": "544f744dc2994b1b8eeab53d76689f8a",
			"secret_name": "toen-access-policy-aud"
		}
	]
}
