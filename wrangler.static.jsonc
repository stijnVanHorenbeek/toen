{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "toen-static-canary",
	"compatibility_date": "2026-08-08",
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"directory": ".generated/static-site",
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "404-page"
	}
}
