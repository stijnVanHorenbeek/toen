/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "toen",
	"main": ".open-next/worker.js",
	"find_additional_modules": true,
	"base_dir": ".open-next/server-functions/default",
	"preserve_file_names": true,
	"rules": [
		{
			"type": "Text",
			"globs": ["**/*.md"],
			"fallthrough": true
		}
	],
	"compatibility_date": "2026-08-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "toen"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"secrets_store_secrets": [
		{
			"binding": "GITHUB_PUBLISH_MODE_STORE",
			"store_id": "544f744dc2994b1b8eeab53d76689f8a",
			"secret_name": "toen-github-publish-mode"
		},
		{
			"binding": "CONTENT_DEPLOY_HOOK_URL_STORE",
			"store_id": "544f744dc2994b1b8eeab53d76689f8a",
			"secret_name": "toen-content-deploy-hook-url"
		},
		{
			"binding": "GITHUB_APP_ID_STORE",
			"store_id": "544f744dc2994b1b8eeab53d76689f8a",
			"secret_name": "toen-github-app-id"
		},
		{
			"binding": "GITHUB_APP_INSTALLATION_ID_STORE",
			"store_id": "544f744dc2994b1b8eeab53d76689f8a",
			"secret_name": "toen-github-app-installation-id"
		},
		{
			"binding": "GITHUB_APP_PRIVATE_KEY_STORE",
			"store_id": "544f744dc2994b1b8eeab53d76689f8a",
			"secret_name": "toen-github-app-private-key"
		},
		{
			"binding": "GITHUB_REPOSITORY_STORE",
			"store_id": "544f744dc2994b1b8eeab53d76689f8a",
			"secret_name": "toen-github-repository"
		},
		{
			"binding": "GITHUB_BASE_BRANCH_STORE",
			"store_id": "544f744dc2994b1b8eeab53d76689f8a",
			"secret_name": "toen-github-base-branch"
		},
		{
			"binding": "ACCESS_TEAM_DOMAIN_STORE",
			"store_id": "544f744dc2994b1b8eeab53d76689f8a",
			"secret_name": "toen-access-team-domain"
		},
		{
			"binding": "ACCESS_POLICY_AUD_STORE",
			"store_id": "544f744dc2994b1b8eeab53d76689f8a",
			"secret_name": "toen-access-policy-aud"
		}
	]
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
}
