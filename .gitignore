# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# generated canonical content
/content/events/
/content/revision.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent artifacts
/.pi/
.pi-subagents/

# OpenNext
/.open-next

# wrangler files
.wrangler
.dev.vars*


!.dev.vars.example

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# playwright-bdd generated specs
**/.features-gen/**/*.spec.js
**/.features-gen/**/*.spec.js.map
**/.features-gen/.bddgen.lock
